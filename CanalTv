package canaltv;

import javax.swing.JOptionPane;


public class CanalTv {

    public static void main(String[] args) 
        
                { String cn = "Digite o número do canal:\n"
                + "2 - Cultura\n"
                + "4 - SBT\n"
                + "5 - Globo\n"
                + "7 - Record\n"
                + "9 - Manchete\n"
                + "11 - Gazeta\n"
                + "13 - Bandeirantes \n";
                
                 cn = JOptionPane.showInputDialog(null, cn);
       
        int canal = Integer.parseInt(cn);
                
        switch(canal) {
         case 2:
             cn = "Cultura" ;
                break;
         case 4:
             cn = "SBT";
             break;
             
         case 5:
             cn = "GLOBO";
             break;
             
         case 7:
             cn = "Record";
             break;
             
         case 9:
             cn = "Manchete";
             break;
             
         case 11:
             cn = "Gazeta";
             break;
             
         case 13:
             cn = "Bandeirantes";
             break;
             
             default:
                cn = "CANAL NÃO DISPONÍVEL";
                JOptionPane.showMessageDialog(null, cn, "ERRO", 0);
                System.exit(0);
    }
        
        cn = "Canal escolhido: " + cn;
                JOptionPane.showMessageDialog(null, cn, "MENSAGEM", 1); 
        System.exit(0);
    
}
}


