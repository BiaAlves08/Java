package calculadora;

/**
 *
 * @author Aluno CA
 */
public class Operacao {
    int soma;
    int menos;
    int vezes;
    float divisao;
    
    public int soma(int a, int b){
        soma = a + b;
        return soma;
    }
        public void imprimir(){
            System.out.println("Valor da soma: " + soma);
        }
        
       public int menos(int a, int b) {
           menos = a - b;
           return menos;
       }
       
       public void Imprimir() {
           System.out.println("Valor da subtração: " + menos);
       }
       
       public int vezes(int a, int b){
           vezes = a * b;
           return vezes;
       }
       
       public void IMPRIMIR() {
           System.out.println("Vaor da multiplicação: " + vezes);
       }
       
       public float divisao(float a, float b){
           divisao = a / b;
           return divisao;
       }
       
       public void imprimiR(){
           System.out.println("Valor da divisão: " + divisao);
       }
    }








