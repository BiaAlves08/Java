package calculadora;

/**
 *
 * @author Aluno CA
 */
public class Calculadora {

    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
        Operacao op = new Operacao();
        op.soma(5, 3);
        op.imprimir();
        
    op.menos(100, 30);
    op.Imprimir();
    
    op.vezes(5, 5);
    op.IMPRIMIR();
    
    op.divisao(10, 7);
    op.imprimiR();
    }

}

